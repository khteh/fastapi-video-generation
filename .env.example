# Copy this file to `.env` and adjust as needed. `.env` itself is
# gitignored (it's meant for local secrets/config), but this example file
# is tracked so the available options are documented.
#
# Every variable below is optional — the app runs with sensible defaults
# if you don't set any of them. Uncomment and edit only what you need to
# change.

# --- Generation provider (plug-and-play) ------------------------------
# "simulated": fully offline, no API keys, no network (default).
# "ai": real AI script writing (Anthropic) + the most natural voice
#       backend available (edge-tts / Piper, falling back to flite/tone).
# GENERATION_PROVIDER=simulated

# --- Anthropic (only used by the "ai" provider) -------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# VIDEO_ANTHROPIC_MODEL=claude-sonnet-5
# VIDEO_ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# --- Concurrency ----------------------------------------------------------
# VIDEO_NUM_WORKERS=3

# --- Output locations -------------------------------------------------------
# VIDEO_JOBS_DIR=output/jobs
# VIDEO_ARTIFACTS_DIR=output/videos

# --- Validation ----------------------------------------------------------
# VIDEO_MIN_TOPIC_LENGTH=5
# VIDEO_MAX_DURATION_SECONDS=90

# --- Video rendering -----------------------------------------------------
# VIDEO_WIDTH=1280
# VIDEO_HEIGHT=720
# VIDEO_FPS=60
# VIDEO_TTS_SAMPLE_RATE=22050

# For 4K output, uncomment these instead. Note: CPU-only H.264 encoding at
# 4K is much slower than at 720p (roughly 20-30x in local testing) — a
# ~48s video took about 2.5 minutes to encode on a modest CPU. Consider
# lowering VIDEO_NUM_WORKERS at 4K, since each job now ties up a worker
# for much longer.
# VIDEO_WIDTH=3840
# VIDEO_HEIGHT=2160

# --- Narrator / voice backend tuning ---------------------------------------
# VIDEO_FLITE_VOICE=kal
# VIDEO_EDGE_TTS_VOICE=en-US-AndrewNeural
# VIDEO_PIPER_MODEL_PATH=/path/to/en_US-lessac-medium.onnx

# --- Hardware-accelerated encoding ------------------------------------------
# "auto" (default): use an NVIDIA GPU (NVENC) if one is actually detected
#   working at startup, otherwise fall back to CPU encoding automatically.
# "cpu": always use CPU encoding (libx264), skip GPU detection entirely.
# VIDEO_HW_ACCEL=auto

# --- ffmpeg binaries -------------------------------------------------------
# VIDEO_FFMPEG_BINARY=ffmpeg
# VIDEO_FFPROBE_BINARY=ffprobe
